<UserControl x:Class="PersonalTools.ClipboardPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style TargetType="Button"><Setter Property="CornerRadius" Value="12"/><Setter Property="MinHeight" Value="32"/></Style>
  <Style TargetType="AppBarButton"><Setter Property="CornerRadius" Value="12"/></Style>
  <Style TargetType="TextBox"><Setter Property="CornerRadius" Value="16"/></Style>
  <Style TargetType="ComboBox"><Setter Property="CornerRadius" Value="12"/></Style>
  <Style TargetType="FlyoutPresenter"><Setter Property="CornerRadius" Value="16"/></Style>
  <Style TargetType="MenuFlyoutPresenter"><Setter Property="CornerRadius" Value="14"/></Style>
 </UserControl.Resources>
 <Border x:Name="PanelChrome" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" CornerRadius="8"
         BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
 <Grid x:Name="Surface" Padding="24,12" RowSpacing="6" KeyDown="PageKeyDown" SizeChanged="SurfaceSizeChanged">
  <Grid.KeyboardAccelerators>
   <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FocusSearchInvoked"/>
  </Grid.KeyboardAccelerators>
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Grid x:Name="SearchSpace" ColumnSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid VerticalAlignment="Center" MaxWidth="440" HorizontalAlignment="Stretch" MinWidth="220">
    <TextBox x:Name="Query" PlaceholderText="기록 검색 · Enter 일반 / Shift+Enter AI" TextChanged="QueryChanged" KeyDown="QueryKeyDown"
             ToolTipService.ToolTip="Ctrl+F: 검색창 · Enter: 일반 검색 · Shift+Enter: Antigravity AI 검색" AutomationProperties.HelpText="Ctrl+F는 검색창으로 이동, Enter는 일반 검색, Shift+Enter는 Antigravity AI 검색"
             Padding="38,8,12,8" MinHeight="38" MaxLength="4000" AutomationProperties.Name="클립보드 검색어"/>
    <FontIcon Glyph="&#xE721;" FontSize="14" Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
              IsHitTestVisible="False" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
   </Grid>
   <ToggleSwitch x:Name="AiMode" Grid.Column="1" OffContent="일반 검색" OnContent="AI 검색" Toggled="ModeChanged"
                 AutomationProperties.Name="일반 검색 또는 AI 검색" VerticalAlignment="Center" HorizontalAlignment="Left" MinWidth="130"/>
   <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
    <Button x:Name="SearchButton" Content="검색" CornerRadius="12" Click="SearchClick" Visibility="Collapsed" Style="{ThemeResource AccentButtonStyle}"/>
    <Button x:Name="CancelButton" Content="취소" Click="CancelClick" Visibility="Collapsed"/>
   </StackPanel>
   <CommandBar x:Name="ToolsBar" Grid.Column="3" Background="Transparent" DefaultLabelPosition="Right" IsOpen="False">
    <AppBarButton x:Name="PauseButton" Icon="Pause" Label="기록 일시정지" Click="PauseClick"/>
    <AppBarButton Icon="Setting" Label="설정" Click="SettingsClick"/>
   </CommandBar>
  </Grid>
  <Grid x:Name="CategoriesRow" Grid.Row="1" ColumnSpacing="8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <ListView x:Name="CategoryTabs" HorizontalAlignment="Left" MaxWidth="800" SelectionChanged="CategoryChanged" SelectionMode="Single"
             ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
             ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
             AutomationProperties.Name="클립보드 카테고리">
    <ListView.Resources><CornerRadius x:Key="ListViewItemCornerRadius">16</CornerRadius></ListView.Resources>
    <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
    <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
     <Setter Property="CornerRadius" Value="16"/><Setter Property="Margin" Value="0,0,6,0"/>
     <Setter Property="Padding" Value="12,4"/><Setter Property="MinHeight" Value="32"/>
    </Style></ListView.ItemContainerStyle>
    <ListView.ItemTemplate><DataTemplate>
     <TextBlock Text="{Binding Name}" Margin="4,0" VerticalAlignment="Center" ContextRequested="CategoryContextRequested"/>
    </DataTemplate></ListView.ItemTemplate>
   </ListView>
   <Button Grid.Column="1" Content="&#xE710;" FontFamily="Segoe Fluent Icons" Click="AddCategoryClick"
           ToolTipService.ToolTip="카테고리 추가" AutomationProperties.Name="카테고리 추가"/>
   <Button x:Name="FilterButton" Grid.Column="2" HorizontalAlignment="Right" Content="필터" Click="FiltersClick" AutomationProperties.Name="프로세스, 날짜, 형식 필터"/>
   <TextBlock x:Name="CountLabel" Grid.Column="3" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
  </Grid>
  <StackPanel Grid.Row="2" Spacing="4">
   <ProgressBar x:Name="Searching" IsIndeterminate="True" Visibility="Collapsed" Height="2"/>
   <ScrollViewer x:Name="AnswerContainer" MaxHeight="54" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
    <TextBlock x:Name="Answer" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite"/>
   </ScrollViewer>
  </StackPanel>
  <Grid Grid.Row="3">
   <ListView x:Name="History" SelectionMode="Single" KeyDown="HistoryKeyDown" IsItemClickEnabled="False"
             ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
             ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
             AutomationProperties.Name="클립보드 카드 목록">
    <ListView.Resources><CornerRadius x:Key="ListViewItemCornerRadius">16</CornerRadius></ListView.Resources>
    <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
    <ListView.ItemContainerStyle><Style TargetType="ListViewItem">
     <Setter Property="Padding" Value="3"/><Setter Property="Margin" Value="0,0,12,0"/>
     <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
     <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem">
      <Grid Background="Transparent" Padding="3">
       <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
        <VisualState x:Name="Normal"/>
        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="HoverRing.Opacity" Value="1"/></VisualState.Setters></VisualState>
        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="HoverRing.Opacity" Value="1"/></VisualState.Setters></VisualState>
        <VisualState x:Name="Selected"><VisualState.Setters><Setter Target="SelectionRing.Opacity" Value="1"/></VisualState.Setters></VisualState>
        <VisualState x:Name="PointerOverSelected"><VisualState.Setters><Setter Target="SelectionRing.Opacity" Value="1"/></VisualState.Setters></VisualState>
        <VisualState x:Name="PressedSelected"><VisualState.Setters><Setter Target="SelectionRing.Opacity" Value="1"/></VisualState.Setters></VisualState>
       </VisualStateGroup></VisualStateManager.VisualStateGroups>
       <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
       <Border x:Name="HoverRing" CornerRadius="17" BorderThickness="1" BorderBrush="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0" IsHitTestVisible="False"/>
       <Border x:Name="SelectionRing" Margin="-3" CornerRadius="19" BorderThickness="2" BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}" Opacity="0" IsHitTestVisible="False"/>
      </Grid>
     </ControlTemplate></Setter.Value></Setter>
    </Style></ListView.ItemContainerStyle>
    <ListView.ItemTemplate><DataTemplate>
     <Border Width="280" Height="210" CornerRadius="16"
             Background="{ThemeResource LayerFillColorDefaultBrush}"
             BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
             DoubleTapped="CardDoubleTapped" ContextRequested="CardContextRequested">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
       <Border CornerRadius="15,15,0,0" Loaded="CardHeaderLoaded" DataContextChanged="CardHeaderDataContextChanged" ActualThemeChanged="CardHeaderThemeChanged">
        <Grid Padding="14,9" ColumnSpacing="10">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
         <StackPanel Spacing="2">
          <TextBlock Text="{Binding FormatLabel}" FontSize="15" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding CopiedAt}" FontSize="11" Opacity="0.8"/>
         </StackPanel>
         <Grid Grid.Column="1" ToolTipService.ToolTip="{Binding Entry.SourceApp}">
          <FontIcon Glyph="{Binding FormatIcon}" FontSize="26" Opacity="0.6"/>
          <Image Width="36" Height="36" Loaded="AppIconLoaded" DataContextChanged="AppIconDataContextChanged" Unloaded="ThumbnailUnloaded" AutomationProperties.Name="{Binding Entry.SourceApp}"/>
         </Grid>
        </Grid>
       </Border>
       <Grid Grid.Row="1" Margin="14,12,14,4">
        <TextBlock Text="{Binding Entry.Preview}" FontSize="15" LineHeight="21" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="7" Visibility="{Binding TextVisibility}"/>
        <Image Loaded="ThumbnailLoaded" Unloaded="ThumbnailUnloaded" DataContextChanged="ThumbnailDataContextChanged" Visibility="{Binding ImageVisibility}" Stretch="Uniform"/>
       </Grid>
       <Grid Grid.Row="2" Margin="14,0,8,4">
        <TextBlock Text="{Binding AppLabel}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,32,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="&#xE712;" FontFamily="Segoe Fluent Icons" Padding="6,0" MinHeight="26" Background="Transparent" BorderThickness="0" Click="CardMenuClick"
                AutomationProperties.Name="카드 작업" ToolTipService.ToolTip="복사, 붙여넣기, 미리보기, 카테고리"/>
       </Grid>
      </Grid>
     </Border>
    </DataTemplate></ListView.ItemTemplate>
   </ListView>
   <TextBlock x:Name="EmptyLabel" Text="복사한 기록이 없습니다." Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsHitTestVisible="False"/>
  </Grid>
  <TextBlock x:Name="StatusText" Grid.Row="4" FontSize="12" TextTrimming="CharacterEllipsis"
             Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
 </Grid>
 </Border>
</UserControl>
