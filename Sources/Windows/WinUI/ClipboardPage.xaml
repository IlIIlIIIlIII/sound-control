<UserControl x:Class="SoundControl.ClipboardPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Padding="24" RowSpacing="12" KeyDown="PageKeyDown">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid ColumnSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="클립보드" FontSize="26" FontWeight="SemiBold"/>
   <Button x:Name="PauseButton" Grid.Column="1" Content="기록 일시정지" Click="PauseClick"/>
   <Button Grid.Column="2" Content="설정" Click="SettingsClick"/>
  </Grid>
  <Grid Grid.Row="1" ColumnSpacing="8">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBox x:Name="Query" PlaceholderText="기록 검색 또는 AI에게 자연어로 질문" TextChanged="QueryChanged" AutomationProperties.Name="클립보드 검색어"/>
   <Button x:Name="SearchButton" Grid.Column="1" Content="AI 검색" Click="SearchClick" Style="{ThemeResource AccentButtonStyle}"/>
   <Button x:Name="CancelButton" Grid.Column="2" Content="취소" Click="CancelClick" Visibility="Collapsed"/>
  </Grid>
  <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
   <ComboBox x:Name="Kind" SelectedIndex="0" SelectionChanged="FilterChanged" AutomationProperties.Name="기록 종류">
    <ComboBoxItem Content="전체" Tag=""/><ComboBoxItem Content="텍스트" Tag="Text"/><ComboBoxItem Content="이미지" Tag="Image"/><ComboBoxItem Content="파일" Tag="Files"/>
   </ComboBox>
   <TextBlock x:Name="CountLabel" VerticalAlignment="Center"/>
   <ProgressRing x:Name="Searching" IsActive="False" Width="20" Height="20"/>
  </StackPanel>
  <ScrollViewer Grid.Row="3" MaxHeight="160" VerticalScrollBarVisibility="Auto">
   <TextBlock x:Name="Answer" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
  </ScrollViewer>
  <Grid Grid.Row="4" ColumnSpacing="16" MinHeight="100">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <ListView x:Name="History" SelectionChanged="SelectionChanged" DoubleTapped="HistoryDoubleTapped" KeyDown="HistoryKeyDown" AutomationProperties.Name="클립보드 기록">
    <ListView.ItemTemplate><DataTemplate>
     <StackPanel Padding="4,8" Spacing="4">
      <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
    </DataTemplate></ListView.ItemTemplate>
   </ListView>
   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="12">
     <TextBlock Text="미리보기" FontWeight="SemiBold"/>
     <Image x:Name="PreviewImage" MaxHeight="300" Stretch="Uniform"/>
     <TextBlock x:Name="PreviewText" Text="복사한 내용을 여기에서 다시 찾아보세요." TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <StackPanel Grid.Row="5" Spacing="8">
   <StackPanel Orientation="Horizontal" Spacing="8">
    <Button Content="복사" Click="CopyClick"/><Button x:Name="PasteButton" Content="붙여넣기" Click="PasteClick"/>
    <Button Content="고정 / 해제" Click="PinClick"/><Button Content="삭제" Click="DeleteClick"/>
   </StackPanel>
   <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12" Opacity="0.75"/>
  </StackPanel>
 </Grid>
</UserControl>
