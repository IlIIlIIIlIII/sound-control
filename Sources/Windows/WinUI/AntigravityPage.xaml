<UserControl x:Class="SoundControl.AntigravityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="1000" Margin="32,28,32,32" Spacing="24">
      <StackPanel Spacing="8">
        <TextBlock Text="Antigravity 브릿지" Style="{ThemeResource TitleTextBlockStyle}"/>
        <TextBlock Text="OpenAI 호환 앱의 요청을 이 PC의 Antigravity CLI로 연결합니다." TextWrapping="Wrap"/>
      </StackPanel>
      <InfoBar x:Name="BridgeInfo" IsOpen="True" IsClosable="False" Title="중지됨" Message="CLI를 확인한 후 브릿지를 시작해 주세요."/>
      <Border Style="{StaticResource Card}">
        <StackPanel Spacing="16">
          <TextBlock Text="CLI 연결" Style="{StaticResource SectionTitle}"/>
          <TextBox x:Name="CliPath" Header="Antigravity CLI 경로" PlaceholderText="agy.exe"/>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="CheckButton" Content="CLI · 모델 확인" Click="CheckCli"/>
            <Button x:Name="LoginButton" Content="CLI 열기 · 로그인" Click="OpenCli"/>
            <HyperlinkButton Content="설치 안내" NavigateUri="https://antigravity.google/docs/cli/overview"/>
          </StackPanel>
          <ComboBox x:Name="ModelBox" Header="기본 모델" IsEditable="True" HorizontalAlignment="Stretch"/>
          <TextBlock Text="antigravity는 CLI 기본 모델을 사용합니다. 클라이언트에서 model을 지정하면 해당 모델로 전달합니다." TextWrapping="Wrap" Opacity="0.7"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel Spacing="16">
          <TextBlock Text="로컬 API" Style="{StaticResource SectionTitle}"/>
          <NumberBox x:Name="PortBox" Header="포트" Minimum="1024" Maximum="65535" Value="8877" SpinButtonPlacementMode="Compact"/>
          <NumberBox x:Name="TimeoutBox" Header="요청 제한 시간 (초)" Minimum="10" Maximum="600" Value="120" SpinButtonPlacementMode="Compact"/>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="StartButton" Content="브릿지 시작" Click="StartBridge" Style="{ThemeResource AccentButtonStyle}"/>
            <Button x:Name="StopButton" Content="중지" Click="StopBridge" IsEnabled="False"/>
          </StackPanel>
          <TextBox x:Name="BaseUrl" Header="Base URL" IsReadOnly="True" Text="http://127.0.0.1:8877/v1"/>
          <PasswordBox x:Name="KeyBox" Header="API 키 (이 PC에 저장됩니다)" PasswordRevealMode="Peek"/>
          <Button Content="연결 주소 · 키 복사" Click="CopyConnection"/>
          <TextBlock Text="앱 실행 시 저장된 설정으로 자동 시작합니다. 이 PC에서만 접속할 수 있으며, 창을 닫아도 트레이에서 실행되고 앱 종료 시 중지됩니다." TextWrapping="Wrap" Opacity="0.7"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel Spacing="12">
          <TextBlock Text="연결 테스트" Style="{StaticResource SectionTitle}"/>
          <TextBox x:Name="TestPrompt" Header="메시지" Text="안녕하세요. 짧게 인사해 주세요." AcceptsReturn="True" TextWrapping="Wrap"/>
          <Button x:Name="TestButton" Content="테스트 전송" Click="TestBridge" IsEnabled="False"/>
          <TextBox x:Name="TestResult" Header="응답" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="240"/>
          <TextBlock Text="텍스트 대화 · 실시간 스트리밍 지원. 이미지, 도구 호출, Responses API 및 생성 옵션은 지원하지 않습니다. 요청은 Antigravity 계정의 사용량을 사용합니다." TextWrapping="Wrap" Opacity="0.7"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
